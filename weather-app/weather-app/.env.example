# ---------------------------------------------------------------------------
# Copy this file to ".env" for local dev. NEVER commit your real .env.
# ---------------------------------------------------------------------------

# Which upstream provider to use: "open-meteo" (default, no key) or "weather-ai"
WEATHER_PROVIDER=open-meteo

# Only needed when WEATHER_PROVIDER=weather-ai.
# Your key stays on the server and is never sent to the browser.
WEATHER_AI_KEY=

# Optional override of the Weather-AI base URL
WEATHER_AI_BASE=https://api.weather-ai.co

# Port (most hosts set this automatically)
PORT=3000
